{%- comment -%}
  Product badge — sale, sold out, custom, new.

  @param {string} type - 'sale' | 'sold-out' | 'new' | 'custom'
  @param {string} [label] - Custom label (for type='custom')
  @param {string} [class] - Additional CSS classes

  @example
    {% render 'badge', type: 'sale' %}
    {% render 'badge', type: 'custom', label: 'Limited' %}
{%- endcomment -%}

{%- liquid
  assign badge_class = 'badge'
  if class != blank
    assign badge_class = badge_class | append: ' ' | append: class
  endif

  case type
    when 'sale'
      assign badge_label = 'products.badges.sale' | t | default: 'Sale'
      assign badge_class = badge_class | append: ' badge--sale'
    when 'sold-out'
      assign badge_label = 'products.badges.sold_out' | t | default: 'Sold out'
      assign badge_class = badge_class | append: ' badge--sold-out'
    when 'new'
      assign badge_label = 'products.badges.new' | t | default: 'New'
      assign badge_class = badge_class | append: ' badge--new'
    when 'custom'
      assign badge_label = label
      assign badge_class = badge_class | append: ' badge--custom'
    else
      assign badge_label = label | default: ''
  endcase
-%}

{%- if badge_label != blank -%}
  <span class="{{ badge_class }}">{{ badge_label }}</span>
{%- endif -%}