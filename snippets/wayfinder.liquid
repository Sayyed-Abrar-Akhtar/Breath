{%- comment -%}
  Breadcrumb + contextual next step.

  @param {array|string} path - Array of {label, url} OR a product/collection/page object
  @param {object} [next_step] - {label, url} (optional)
{%- endcomment -%}

{%- liquid
  if path.url
    assign path_type = path.object_type | default: path.type
    assign crumbs = ''

    case path_type
      when 'product'
        assign collection = path.collections.first
        if collection
          assign crumb = collection | default: nil
          assign crumbs = crumbs | append: '<li><a href="' | append: collection.url | append: '">' | append: collection.title | append: '</a></li>'
        endif
        assign crumbs = crumbs | append: '<li aria-current="page">' | append: path.title | append: '</li>'

      when 'collection'
        assign crumbs = '<li><a href="' | append: routes.root_url | append: '">Home</a></li><li aria-current="page">' | append: path.title | append: '</li>'

      when 'page'
        assign crumbs = '<li><a href="' | append: routes.root_url | append: '">Home</a></li><li aria-current="page">' | append: path.title | append: '</li>'

      when 'article'
        assign crumbs = '<li><a href="' | append: routes.root_url | append: '">Home</a></li><li><a href="' | append: path.blog.url | append: '">' | append: path.blog.title | append: '</a></li><li aria-current="page">' | append: path.title | append: '</li>'

      else
        assign crumbs = '<li><a href="' | append: routes.root_url | append: '">Home</a></li>'
    endcase
  else
    # Assume path is an array of {label, url}
    assign crumbs = ''
    for crumb in path
      if crumb.url
        assign crumbs = crumbs | append: '<li><a href="' | append: crumb.url | append: '">' | append: crumb.label | append: '</a></li>'
      else
        assign crumbs = crumbs | append: '<li aria-current="page">' | append: crumb.label | append: '</li>'
      endif
    endfor
  endif
-%}

{%- if crumbs != blank -%}
  <nav class="wayfinder container" aria-label="{{ 'accessibility.breadcrumb' | t | default: 'Breadcrumb' }}">
    <ol class="wayfinder__path">
      {{ crumbs }}
    </ol>

    {%- if next_step -%}
      <a href="{{ next_step.url }}" class="wayfinder__next">
        {{ next_step.label }}
        <span aria-hidden="true">&#8594;</span>
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}