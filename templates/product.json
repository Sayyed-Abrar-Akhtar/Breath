{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "layout": "media-first"
      },
      "blocks": {
        "media": {
          "type": "media_gallery",
          "settings": { "layout": "stacked" }
        },
        "title": { "type": "title" },
        "vendor": { "type": "vendor" },
        "price": {
          "type": "price",
          "settings": { "show_taxes_note": true }
        },
        "variant-picker": { "type": "variant_picker" },
        "quantity": { "type": "quantity" },
        "buy": { "type": "buy_buttons" },
        "installments": { "type": "shop_pay_installments" },
        "pickup": { "type": "pickup" },
        "description": { "type": "description" },
        "details": {
          "type": "collapsible",
          "settings": {
            "heading": "Details",
            "default_open": false
          }
        },
        "shipping": {
          "type": "collapsible",
          "settings": {
            "heading": "Shipping & returns",
            "default_open": false
          }
        }
      },
      "block_order": [
        "media",
        "title",
        "vendor",
        "price",
        "variant-picker",
        "quantity",
        "buy",
        "installments",
        "pickup",
        "description",
        "details",
        "shipping"
      ]
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "Complete the set"
      }
    }
  },
  "order": ["main", "related"]
}
