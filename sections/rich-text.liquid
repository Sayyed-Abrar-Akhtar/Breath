<section class="rich-text section" data-section-id="{{ section.id }}">
  <div class="container container--narrow">
    {%- capture rich_content -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="rich-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="rich-text__body rte">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <div class="rich-text__cta">
          {% render 'signpost',
            label: section.settings.cta_label,
            url: section.settings.cta_url,
            style: 'text'
          %}
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {% render 'reveal',
      content: rich_content,
      variant: 'stagger',
      delay: 80,
      class: 'rich-text__inner'
    %}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}