{%- comment -%}
  Static hero. No carousel, no autoplay, no slideshow.
  A single image, a single message, a single signpost.
{%- endcomment -%}

<section class="hero{% if section.settings.full_height %} hero--full{% endif %}" data-section-id="{{ section.id }}">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {% render 'responsive-image',
        image: section.settings.image,
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        aspect_ratio: section.settings.aspect_ratio,
        class: 'hero__image'
      %}
    {%- else -%}
      <div class="hero__image hero__image--placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {%- endif -%}

    {%- if section.settings.overlay_opacity > 0 -%}
      <div
        class="hero__overlay"
        style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
        aria-hidden="true"
      ></div>
    {%- endif -%}
  </div>

  <div class="hero__content container">
    {%- capture hero_body -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <div class="hero__cta">
          {% render 'signpost',
            label: section.settings.cta_label,
            url: section.settings.cta_url,
            context: section.settings.cta_context,
            style: 'primary'
          %}
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {% render 'reveal', content: hero_body, variant: 'stagger', delay: 100 %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9 (widescreen)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "21 / 9", "label": "21:9 (cinematic)" }
      ],
      "default": "16 / 9"
    },
    { "type": "checkbox", "id": "full_height", "label": "Fill viewport height", "default": false },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A slower way to browse" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Enter the collection" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "text", "id": "cta_context", "label": "CTA context (optional)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}