<section class="image-with-text section" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="image-with-text__grid image-with-text__grid--{{ section.settings.layout }}">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {% render 'responsive-image',
            image: section.settings.image,
            sizes: '(min-width: 1024px) 50vw, 100vw',
            loading: 'lazy',
            aspect_ratio: section.settings.aspect_ratio,
            class: 'image-with-text__image'
          %}
        {%- else -%}
          <div class="image-with-text__image image-with-text__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- capture content_body -%}
          {%- if section.settings.eyebrow != blank -%}
            <p class="image-with-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="image-with-text__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="image-with-text__body rte">{{ section.settings.body }}</div>
          {%- endif -%}

          {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
            <div class="image-with-text__cta">
              {% render 'signpost',
                label: section.settings.cta_label,
                url: section.settings.cta_url,
                context: section.settings.cta_context,
                style: 'text'
              %}
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {% render 'reveal', content: content_body, variant: 'stagger', delay: 80 %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-first", "label": "Image first" },
        { "value": "text-first", "label": "Text first" }
      ],
      "default": "image-first"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "text", "id": "cta_context", "label": "CTA context" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}