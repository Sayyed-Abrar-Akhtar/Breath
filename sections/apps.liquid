{%- comment -%}
  MANDATORY SECTION.
  Renders @app blocks provided by installed apps.
  Required by Shopify Theme Store.
{%- endcomment -%}

<section class="apps-section section" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="apps-section__blocks">
        {%- for block in section.blocks -%}
          <div class="apps-section__block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Apps",
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}