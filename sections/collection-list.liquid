<section class="collection-list section" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <header class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- capture list_content -%}
        {%- for block in section.blocks -%}
          {%- assign coll = collections[block.settings.collection] -%}
          <article class="collection-card" {{ block.shopify_attributes }}>
            <a href="{{ coll.url | default: '#' }}" class="collection-card__link">
              <div class="collection-card__media">
                {%- if coll.image -%}
                  {% render 'responsive-image',
                    image: coll.image,
                    sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
                    loading: 'lazy',
                    aspect_ratio: '4 / 5',
                    class: 'collection-card__image'
                  %}
                {%- elsif block.settings.image != blank -%}
                  {% render 'responsive-image',
                    image: block.settings.image,
                    sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
                    loading: 'lazy',
                    aspect_ratio: '4 / 5',
                    class: 'collection-card__image'
                  %}
                {%- else -%}
                  <div class="collection-card__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </div>

              <div class="collection-card__info">
                <h3 class="collection-card__title">
                  {{ coll.title | default: block.settings.title }}
                </h3>
                {%- if coll.all_products_count -%}
                  <p class="collection-card__count">
                    {{ coll.all_products_count }} {{ 'collections.pieces' | t | default: 'pieces' }}
                  </p>
                {%- endif -%}
              </div>
            </a>
          </article>
        {%- endfor -%}
      {%- endcapture -%}

      {% render 'reveal',
        content: list_content,
        variant: 'stagger',
        delay: 80,
        class: 'collection-list__grid'
      %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Fallback image" },
        { "type": "text", "id": "title", "label": "Fallback title" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}