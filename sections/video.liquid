<section class="video-section section" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <header class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}

    <div class="video-section__media">
      {%- if section.settings.video != blank -%}
        {% render 'responsive-video',
          media: section.settings.video,
          aspect_ratio: section.settings.aspect_ratio,
          autoplay: false,
          loop: false,
          controls: true
        %}
      {%- elsif section.settings.external_video_url != blank -%}
        <div class="video-section__external" style="aspect-ratio: {{ section.settings.aspect_ratio }};">
          {%- if section.settings.external_video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.external_video_url.id }}"
              title="{{ section.settings.heading | default: 'Video' | escape }}"
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          {%- elsif section.settings.external_video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.external_video_url.id }}"
              title="{{ section.settings.heading | default: 'Video' | escape }}"
              loading="lazy"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="video-section__placeholder" style="aspect-ratio: {{ section.settings.aspect_ratio }};">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="video-section__caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "video_url", "id": "external_video_url", "label": "YouTube or Vimeo URL", "accept": ["youtube", "vimeo"] },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9 (widescreen)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "1 / 1", "label": "1:1 (square)" }
      ],
      "default": "16 / 9"
    },
    { "type": "text", "id": "caption", "label": "Caption" }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}