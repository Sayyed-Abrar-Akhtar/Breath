        "max": 2.0,
        "step": 0.1,
        "default": 1.6
      },
      {
        "type": "range",
        "id": "line_height_loose",
        "label": "Line height (loose)",
        "min": 1.6,
        "max": 2.2,
        "step": 0.1,
        "default": 1.8
      }
    ]
